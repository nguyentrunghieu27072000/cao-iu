<title>Thiệp 20/10</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Be+Vietnam+Pro:wght@300;400;600&family=Dancing+Script:wght@500;700&display=swap">
<style>
/* Layout: a sealed envelope covers the screen; opening it reveals a one-column night garden that scrolls
   from the greeting, through a letter, a wish garden and a photo wall, to the sign-off. Single dark theme by choice. */
:root{
  --bg:#190a1f; --bg-2:#2a1134; --bg-3:#3b1a45;
  --fg:#fbeef3; --muted:#cfa9bd;
  --rose:#ff7fa6; --rose-deep:#d9426f; --rose-soft:#ffc3d4;
  --gold:#f4cd7a; --gold-deep:#c9962f;
  --paper:#fff7f1; --paper-2:#f6e5df; --ink:#3b1d2d; --ink-soft:#7a4f62;
  --display:"Playfair Display",Georgia,"Times New Roman",serif;
  --body:"Be Vietnam Pro","Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  --script:"Dancing Script","Brush Script MT",cursive;
  --gutter-l:max(16px,env(safe-area-inset-left,0px));
  --gutter-r:max(16px,env(safe-area-inset-right,0px));
  color-scheme:dark;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--body);font-weight:300;line-height:1.65;overflow-x:hidden;font-size:16px}
body.locked{overflow:hidden;height:100vh}
h1,h2,h3{margin:0;font-family:var(--display);font-weight:400;text-wrap:balance;line-height:1.1}
p{margin:0}
button{font:inherit;cursor:pointer;border:0;background:none;color:inherit}
button:focus-visible,a:focus-visible{outline:2px solid var(--gold);outline-offset:4px}
img{max-width:100%;display:block}

/* ---------- ambient canvas ---------- */
#sky{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.vignette{position:fixed;inset:0;z-index:0;pointer-events:none;
  background:radial-gradient(ellipse at 50% 20%,rgba(255,127,166,.16),transparent 55%),
             radial-gradient(ellipse at 80% 90%,rgba(244,205,122,.10),transparent 50%),
             linear-gradient(180deg,var(--bg) 0%,var(--bg-2) 60%,var(--bg) 100%)}

/* ---------- cover / envelope ---------- */
#cover{position:fixed;inset:0;z-index:50;display:grid;place-items:center;
  padding-block:24px;padding-left:var(--gutter-l);padding-right:var(--gutter-r);
  background:radial-gradient(circle at 50% 40%,#3a1746 0%,#190a1f 70%);
  transition:opacity 1.1s ease .5s,visibility 0s 1.7s}
#cover.gone{opacity:0;visibility:hidden}
.cover-inner{display:grid;gap:28px;justify-items:center;text-align:center;max-width:520px;width:100%}
.cover-eyebrow{font-size:.78rem;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);font-weight:400}
.cover-title{font-size:clamp(1.9rem,6vw,2.8rem);font-style:italic;color:var(--fg)}
.cover-sub{color:var(--muted);max-width:34ch}

.env{position:relative;width:min(320px,82vw);aspect-ratio:1.5;perspective:1200px;cursor:pointer;
  filter:drop-shadow(0 30px 40px rgba(0,0,0,.45))}
.env-back{position:absolute;inset:0;background:linear-gradient(160deg,#f8d7e1,#e8a9bf);border-radius:10px}
.env-letter{position:absolute;left:6%;right:6%;top:8%;bottom:6%;background:var(--paper);border-radius:6px;
  display:grid;place-items:center;transform:translateY(0);transition:transform 1.1s cubic-bezier(.2,.7,.2,1) .55s;
  box-shadow:0 10px 30px rgba(0,0,0,.25)}
.env-letter span{font-family:var(--script);font-size:clamp(1.6rem,7vw,2.4rem);color:var(--rose-deep)}
.env-front{position:absolute;inset:0;border-radius:10px;overflow:hidden;
  background:linear-gradient(180deg,#f5c9d8 0%,#ec9fbb 100%)}
.env-front::before,.env-front::after{content:"";position:absolute;inset:0;background:linear-gradient(170deg,#fde3ec,#f0b3c9)}
.env-front::before{clip-path:polygon(0 0,50% 58%,0 100%)}
.env-front::after{clip-path:polygon(100% 0,50% 58%,100% 100%)}
.env-bottom{position:absolute;inset:0;background:linear-gradient(0deg,#f9d4e0,#f3bfd1);clip-path:polygon(0 100%,50% 50%,100% 100%)}
.env-flap{position:absolute;left:0;right:0;top:0;height:56%;transform-origin:top center;
  background:linear-gradient(180deg,#ffd9e5,#f5b8cc);clip-path:polygon(0 0,100% 0,50% 100%);
  transform:rotateX(0deg);transition:transform .9s cubic-bezier(.4,0,.2,1);z-index:3}
.env.open .env-flap{transform:rotateX(-178deg);z-index:1}
.env.open .env-letter{transform:translateY(-62%)}
.seal{position:absolute;left:50%;top:50%;width:62px;height:62px;transform:translate(-50%,-30%);z-index:4;
  border-radius:50%;background:radial-gradient(circle at 35% 30%,#ff9fbe,#c62d5c 70%);
  box-shadow:0 6px 14px rgba(120,20,60,.45),inset 0 0 0 4px rgba(255,255,255,.18);
  display:grid;place-items:center;font-family:var(--display);font-style:italic;color:#fff2f6;font-size:.95rem;
  transition:transform .5s ease,opacity .4s ease}
.env.open .seal{transform:translate(-50%,-30%) scale(.2);opacity:0}
.env:not(.open){animation:breathe 3.2s ease-in-out infinite}
@keyframes breathe{0%,100%{transform:translateY(0) rotate(-1deg)}50%{transform:translateY(-8px) rotate(1deg)}}
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:999px;
  background:linear-gradient(135deg,var(--rose),var(--rose-deep));color:#fff;font-weight:600;letter-spacing:.02em;
  box-shadow:0 10px 30px rgba(217,66,111,.35);transition:transform .2s ease,box-shadow .2s ease}
.btn:hover{transform:translateY(-2px);box-shadow:0 14px 36px rgba(217,66,111,.45)}
.btn small{font-weight:300;opacity:.85}

/* ---------- page ---------- */
#page{position:relative;z-index:1;opacity:0;transition:opacity 1.2s ease .9s}
#page.show{opacity:1}
.wrap{max-width:1040px;margin:0 auto;padding-left:var(--gutter-l);padding-right:var(--gutter-r)}
section{padding-block:clamp(64px,10vw,120px)}

.hero{min-height:88vh;display:grid;align-content:center;text-align:center;gap:18px;padding-block:80px 40px}
.hero .date{font-family:var(--display);font-style:italic;font-weight:700;
  font-size:clamp(5.5rem,22vw,13rem);line-height:.9;letter-spacing:-.03em;
  background:linear-gradient(180deg,#ffd0de 0%,var(--rose) 45%,var(--gold) 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  filter:drop-shadow(0 10px 40px rgba(255,127,166,.25))}
.hero .date b{font-weight:400;font-style:normal;font-size:.55em;vertical-align:.25em;color:var(--gold);
  -webkit-text-fill-color:var(--gold);margin:0 .05em}
.hero h1{font-size:clamp(1.4rem,4.2vw,2.3rem);font-style:italic;color:var(--fg)}
.hero .to{font-family:var(--script);font-size:clamp(2.2rem,8vw,4rem);color:var(--gold);line-height:1.2}
.hero .lead{color:var(--muted);max-width:52ch;margin:0 auto}
.rise{opacity:0;transform:translateY(24px);animation:rise 1.1s cubic-bezier(.2,.7,.2,1) forwards}
@keyframes rise{to{opacity:1;transform:none}}
.scroll-hint{margin-top:30px;display:grid;justify-items:center;gap:6px;color:var(--muted);font-size:.78rem;letter-spacing:.2em;text-transform:uppercase}
.scroll-hint i{width:1px;height:46px;background:linear-gradient(var(--gold),transparent);animation:drip 1.8s ease-in-out infinite}
@keyframes drip{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

.eyebrow{font-size:.78rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);font-weight:400;margin-bottom:14px}
.sec-title{font-size:clamp(1.9rem,5vw,3rem);font-style:italic;margin-bottom:28px}

/* letter */
.letter{position:relative;background:var(--paper);color:var(--ink);border-radius:4px;max-width:680px;margin:0 auto;
  padding:clamp(28px,6vw,56px);box-shadow:0 30px 80px rgba(0,0,0,.45),0 2px 0 rgba(255,255,255,.6) inset;
  transform:rotate(-.6deg);
  background-image:repeating-linear-gradient(180deg,transparent 0 31px,rgba(122,79,98,.09) 31px 32px)}
.letter::before{content:"";position:absolute;inset:10px;border:1px solid rgba(217,66,111,.18);border-radius:3px;pointer-events:none}
.letter .stamp{position:absolute;right:18px;top:18px;width:72px;height:88px;border:1px dashed var(--rose-deep);border-radius:4px;
  display:grid;place-items:center;font-family:var(--display);font-style:italic;color:var(--rose-deep);font-size:.9rem;transform:rotate(6deg);
  background:repeating-linear-gradient(45deg,#fff 0 4px,#fde4ec 4px 8px)}
.letter .greet{font-family:var(--script);font-size:clamp(1.8rem,5vw,2.4rem);color:var(--rose-deep);margin-bottom:18px}
.letter .body{font-size:1.05rem;line-height:32px;white-space:pre-wrap;min-height:6em;max-width:60ch}
.letter .cursor{display:inline-block;width:2px;height:1.1em;background:var(--rose-deep);vertical-align:-.2em;margin-left:2px;animation:blink 1s step-end infinite}
@keyframes blink{50%{opacity:0}}
.letter .sign{margin-top:26px;text-align:right;font-family:var(--script);font-size:1.7rem;color:var(--ink);opacity:0;transition:opacity 1s}
.letter .sign.on{opacity:1}

/* garden */
.garden{text-align:center}
.garden-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:clamp(8px,3vw,28px);margin-top:10px}
.flower{position:relative;width:clamp(120px,24vw,180px);display:grid;justify-items:center;gap:8px;padding:8px;border-radius:16px;
  transition:transform .3s ease}
.flower svg{width:100%;height:auto;display:block;overflow:visible}
.flower .petals{transform-origin:50px 50px;transform:scale(0);transition:transform 1.4s cubic-bezier(.2,.9,.2,1.1)}
.flower.bloom .petals{transform:scale(1)}
.flower .petals g{transform-origin:50px 50px}
.flower .stem{stroke-dasharray:60;stroke-dashoffset:60;transition:stroke-dashoffset 1s ease}
.flower.bloom .stem{stroke-dashoffset:0}
.flower:hover,.flower:focus-visible{transform:translateY(-6px)}
.flower.bloom.sway svg{animation:sway 4s ease-in-out infinite;transform-origin:50% 100%}
@keyframes sway{0%,100%{transform:rotate(-2.5deg)}50%{transform:rotate(2.5deg)}}
.flower .cap{font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.wish{margin:34px auto 0;max-width:560px;min-height:92px;padding:22px 26px;border-radius:14px;
  background:rgba(255,255,255,.06);border:1px solid rgba(255,195,212,.25);backdrop-filter:blur(8px);
  font-family:var(--display);font-style:italic;font-size:clamp(1.05rem,3vw,1.35rem);line-height:1.55;color:var(--fg);
  transition:opacity .35s ease,transform .35s ease}
.wish.swap{opacity:0;transform:translateY(8px)}
.wish small{display:block;margin-top:8px;font-family:var(--body);font-style:normal;font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold)}

/* gallery */
.wall{display:flex;flex-wrap:wrap;justify-content:center;gap:clamp(16px,3vw,34px);padding-block:10px}
.pola{width:min(250px,44vw);background:#fff;padding:10px 10px 38px;border-radius:3px;color:var(--ink);
  box-shadow:0 20px 50px rgba(0,0,0,.45);transform:rotate(var(--tilt,0deg));transition:transform .4s cubic-bezier(.2,.7,.2,1);position:relative}
.pola:hover{transform:rotate(0deg) scale(1.04);z-index:2}
.pola .ph{aspect-ratio:1;width:100%;max-width:100%;overflow:hidden;background:#f1dfe6}
.pola .ph img,.pola .ph canvas{width:100%;height:100%;object-fit:cover;display:block}
.pola .cap{position:absolute;left:0;right:0;bottom:10px;text-align:center;font-family:var(--script);font-size:1.25rem;color:var(--ink-soft)}
.pola .tape{position:absolute;left:50%;top:-12px;width:90px;height:26px;transform:translateX(-50%) rotate(-3deg);
  background:rgba(244,205,122,.55);backdrop-filter:blur(2px);box-shadow:0 1px 4px rgba(0,0,0,.15)}
.wall-note{text-align:center;color:var(--muted);font-size:.9rem;margin-top:30px;max-width:56ch;margin-inline:auto}

/* finale */
.finale{text-align:center;padding-bottom:140px}
.finale h2{font-size:clamp(2rem,7vw,4.2rem);font-style:italic}
.finale .big{font-family:var(--script);font-size:clamp(2.4rem,9vw,5rem);color:var(--gold);line-height:1.2;margin-top:12px}
.finale p{color:var(--muted);margin-top:18px}
.finale .btn{margin-top:30px}
.heart{display:inline-block;animation:beat 1.4s ease-in-out infinite;color:var(--rose)}
@keyframes beat{0%,100%{transform:scale(1)}30%{transform:scale(1.25)}60%{transform:scale(1.05)}}

/* music fab */
#music{position:fixed;right:calc(16px + env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:40;
  display:flex;align-items:center;gap:10px;padding:10px 16px 10px 12px;border-radius:999px;
  background:rgba(25,10,31,.75);border:1px solid rgba(255,195,212,.3);backdrop-filter:blur(10px);color:var(--fg);font-size:.85rem;
  opacity:0;transform:translateY(20px);transition:opacity .6s ease 1.8s,transform .6s ease 1.8s}
#music.show{opacity:1;transform:none}
#music .bars{display:flex;align-items:flex-end;gap:2px;height:16px}
#music .bars i{width:3px;background:var(--rose);height:30%;border-radius:2px}
#music.playing .bars i{animation:eq .8s ease-in-out infinite}
#music .bars i:nth-child(2){animation-delay:.15s}#music .bars i:nth-child(3){animation-delay:.3s}#music .bars i:nth-child(4){animation-delay:.45s}
@keyframes eq{0%,100%{height:30%}50%{height:100%}}

/* auto-play mode */
body.auto .scroll-hint{display:none}
.wish.float{position:fixed;left:var(--gutter-l);right:var(--gutter-r);bottom:calc(76px + env(safe-area-inset-bottom,0px));z-index:30;
  margin:0 auto;max-width:560px;background:rgba(25,10,31,.88);box-shadow:0 20px 50px rgba(0,0,0,.5)}
.flower.active{transform:scale(1.12)}
.flower.active svg{filter:drop-shadow(0 0 16px rgba(255,127,166,.85))}
#replayBtn{margin-top:18px;opacity:0;transition:opacity .8s}
#replayBtn.on{opacity:1}
.toast{position:fixed;left:50%;top:calc(14px + env(safe-area-inset-top,0px));transform:translateX(-50%);z-index:45;
  padding:8px 16px;border-radius:999px;background:rgba(25,10,31,.85);border:1px solid rgba(255,195,212,.3);font-size:.8rem;color:var(--muted);
  opacity:0;transition:opacity .4s;pointer-events:none;white-space:nowrap}
.toast.on{opacity:1}

/* reveal on scroll (visible by default; animates only once JS marks it) */
.io{transition:opacity .9s ease,transform .9s cubic-bezier(.2,.7,.2,1)}
.io.pre{opacity:0;transform:translateY(28px)}
.io.in{opacity:1;transform:none}

@media (max-width:520px){
  .letter{transform:none}
  .letter .stamp{width:56px;height:70px;font-size:.75rem;right:12px;top:12px}
  .pola{width:min(250px,calc(50% - 10px))}
}
@media (prefers-reduced-motion:reduce){
  .env:not(.open),.heart,.scroll-hint i,.flower.bloom.sway svg,#music.playing .bars i{animation:none}
  .rise{animation-duration:.01s}
  .io,.flower .petals,.flower .stem,.env-flap,.env-letter{transition-duration:.01s}
  html{scroll-behavior:auto}
}
</style>

<canvas id="sky" aria-hidden="true"></canvas>
<div class="vignette" aria-hidden="true"></div>

<!-- ============ COVER ============ -->
<div id="cover" role="dialog" aria-label="Thiệp chúc mừng">
  <div class="cover-inner">
    <div class="cover-eyebrow">Ngày Phụ nữ Việt Nam</div>
    <div class="env" id="env" role="button" tabindex="0" aria-label="Mở thiệp">
      <div class="env-back"></div>
      <div class="env-letter"><span>Dành cho em</span></div>
      <div class="env-front"></div>
      <div class="env-bottom"></div>
      <div class="env-flap"></div>
      <div class="seal">20.10</div>
    </div>
    <h2 class="cover-title">Có một lá thư đang chờ</h2>
    <p class="cover-sub">Chạm vào phong bì để mở thiệp. Bật loa lên nhé, có một bài hát đi kèm.</p>
    <button class="btn" id="openBtn">Mở thiệp <small>♪ kèm nhạc</small></button>
  </div>
</div>

<!-- ============ PAGE ============ -->
<main id="page">
  <section class="hero wrap">
    <div class="date rise" style="animation-delay:.2s">20<b>·</b>10</div>
    <h1 class="rise" style="animation-delay:.5s">Chúc mừng Ngày Phụ nữ Việt Nam</h1>
    <div class="to rise" id="heroName" style="animation-delay:.8s"></div>
    <p class="lead rise" id="heroLead" style="animation-delay:1.05s"></p>
    <div class="scroll-hint rise" style="animation-delay:1.4s"><span>Cuộn xuống</span><i></i></div>
  </section>

  <section class="wrap io">
    <div class="eyebrow" style="text-align:center">Lá thư</div>
    <div class="letter">
      <div class="stamp">20·10</div>
      <div class="greet" id="letterGreet"></div>
      <div class="body" id="letterBody"><span class="cursor"></span></div>
      <div class="sign" id="letterSign"></div>
    </div>
  </section>

  <section class="wrap garden io">
    <div class="eyebrow">Vườn lời chúc</div>
    <h2 class="sec-title">Chạm vào một bông hoa</h2>
    <div class="garden-grid" id="garden"></div>
    <div class="wish" id="wish" aria-live="polite">Mỗi bông hoa giữ một lời chúc. Chọn một bông đi, em.<small>5 bông · 5 lời chúc</small></div>
  </section>

  <section class="wrap io">
    <div class="eyebrow" style="text-align:center">Khoảnh khắc</div>
    <h2 class="sec-title" style="text-align:center">Những điều đáng nhớ</h2>
    <div class="wall" id="wall"></div>
    <p class="wall-note" id="wallNote"></p>
  </section>

  <section class="wrap finale io">
    <h2>Chúc em một ngày</h2>
    <div class="big" id="finaleBig">thật rực rỡ</div>
    <p id="finaleText"></p>
    <p style="margin-top:28px;font-size:1.3rem"><span class="heart">♥</span></p>
    <button class="btn" id="burstBtn">Tung hoa lần nữa</button>
    <div><button class="btn" id="replayBtn" hidden>Xem lại từ đầu</button></div>
  </section>
</main>
<div class="toast" id="toast" aria-live="polite"></div>

<button id="music" aria-pressed="false" aria-label="Bật hoặc tắt nhạc">
  <span class="bars"><i></i><i></i><i></i><i></i></span><span id="musicLabel">Nhạc đang phát</span>
</button>

<script>
/* ===================== CHỈNH NỘI DUNG Ở ĐÂY ===================== */
const CONFIG = {
  name: "Em",                       // tên người nhận, ví dụ "Linh" / "Mẹ" / "Chị Hoa"
  sender: "Người luôn ở bên em",    // chữ ký cuối thư
  lead: "Một tấm thiệp nhỏ, làm bằng ánh sáng và vài nốt nhạc, để nói rằng em đáng được nâng niu mỗi ngày, không chỉ hôm nay.",
  letter:
`Hôm nay là 20 tháng 10, và anh muốn nói với em một vài điều.

Cảm ơn em vì đã kiên nhẫn với những lần anh vụng về, vì nụ cười của em làm những ngày xám xịt trở nên dễ thở hơn, và vì em luôn là chính em, mạnh mẽ nhưng dịu dàng.

Chúc em luôn khoẻ mạnh, luôn được yêu thương, và luôn tin rằng em xứng đáng với mọi điều tốt đẹp nhất trên đời.`,
  wishes: [
    { t: "Chúc em luôn khoẻ mạnh, ngủ đủ giấc và thức dậy với một tâm trạng thật nhẹ.", k: "Sức khoẻ" },
    { t: "Chúc em mọi dự định trong năm nay đều có người tiếp sức, và em luôn về đích với nụ cười.", k: "Công việc" },
    { t: "Chúc em được yêu đúng cách: không phải vì em hoàn hảo, mà vì em là em.", k: "Tình yêu" },
    { t: "Chúc em luôn giữ được sự tò mò, để mỗi ngày đều có một điều nhỏ làm em thích thú.", k: "Niềm vui" },
    { t: "Chúc em luôn có người lắng nghe, những khi vui lẫn những khi mỏi mệt.", k: "Bình yên" }
  ],
  // Ảnh của hai bạn: đặt file ảnh cạnh index.html rồi điền tên vào đây, ví dụ:
  // { src: "photos/1.jpg", cap: "Đà Lạt, tháng 3" }
  // Để trống thì trang tự vẽ tranh minh hoạ.
  photos: [],
  finale: "Mong rằng mỗi ngày của em đều có nắng, có hoa, có một bài hát hay và có người nhớ về em.",
  // Muốn dùng bài hát riêng: đặt file mp3 cạnh index.html rồi điền tên, ví dụ "music.mp3".
  // Để trống thì trang tự chơi một giai điệu piano dịu được tổng hợp ngay trên trình duyệt.
  musicFile: "chochut.mp3",   // Chờ Chút... - CongB
  musicTitle: "Chờ Chút... · CongB"
};
/* ================================================================= */

const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
const $ = s => document.querySelector(s);

/* ---------- fill text ---------- */
$('#heroName').textContent = 'Gửi ' + CONFIG.name;
$('#heroLead').textContent = CONFIG.lead;
$('#letterGreet').textContent = CONFIG.name + ' thân mến,';
$('#letterSign').textContent = '— ' + CONFIG.sender;
$('#finaleText').textContent = CONFIG.finale;
$('.env-letter span').textContent = 'Dành cho ' + CONFIG.name;
document.body.classList.add('locked');

/* ---------- sky: petals + bokeh (canvas) ---------- */
const sky = $('#sky'), ctx = sky.getContext('2d');
let W, H, petals = [], bokeh = [], burst = [];
function resize(){ W = sky.width = innerWidth * devicePixelRatio; H = sky.height = innerHeight * devicePixelRatio; }
addEventListener('resize', resize); resize();
const rnd = (a,b) => a + Math.random()*(b-a);
function mkPetal(y){
  return { x: rnd(0,W), y: y ?? rnd(-H,0), r: rnd(6,14)*devicePixelRatio, a: rnd(0,Math.PI*2), va: rnd(-.02,.02),
    vy: rnd(.4,1.1)*devicePixelRatio, sw: rnd(.4,1.2), ph: rnd(0,Math.PI*2), hue: Math.random()<.7? 'rose':'gold', o: rnd(.5,.95) };
}
const N = reduce ? 14 : Math.min(60, Math.round(innerWidth/14));
for (let i=0;i<N;i++) petals.push(mkPetal(rnd(0,H)));
for (let i=0;i<22;i++) bokeh.push({ x: rnd(0,W), y: rnd(0,H), r: rnd(20,90)*devicePixelRatio, o: rnd(.03,.09), vx: rnd(-.08,.08), vy: rnd(-.12,.04) });
function petal(p){
  ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.a);
  const g = ctx.createLinearGradient(-p.r,0,p.r,0);
  if (p.hue==='rose'){ g.addColorStop(0,'rgba(255,195,212,'+p.o+')'); g.addColorStop(1,'rgba(255,127,166,'+p.o+')'); }
  else { g.addColorStop(0,'rgba(255,236,190,'+p.o+')'); g.addColorStop(1,'rgba(244,205,122,'+p.o+')'); }
  ctx.fillStyle = g;
  ctx.beginPath();
  ctx.moveTo(0,-p.r);
  ctx.bezierCurveTo(p.r*.9,-p.r*.6, p.r*.9,p.r*.6, 0,p.r);
  ctx.bezierCurveTo(-p.r*.9,p.r*.6, -p.r*.9,-p.r*.6, 0,-p.r);
  ctx.fill(); ctx.restore();
}
let t0 = 0;
function frame(ts){
  const dt = Math.min(40, ts - t0) / 16.7; t0 = ts;
  ctx.clearRect(0,0,W,H);
  for (const b of bokeh){
    b.x += b.vx*dt*devicePixelRatio; b.y += b.vy*dt*devicePixelRatio;
    if (b.y < -b.r) { b.y = H + b.r; b.x = rnd(0,W); } if (b.x < -b.r) b.x = W+b.r; if (b.x > W+b.r) b.x = -b.r;
    const g = ctx.createRadialGradient(b.x,b.y,0,b.x,b.y,b.r);
    g.addColorStop(0,'rgba(255,170,200,'+b.o+')'); g.addColorStop(1,'rgba(255,170,200,0)');
    ctx.fillStyle = g; ctx.beginPath(); ctx.arc(b.x,b.y,b.r,0,7); ctx.fill();
  }
  for (const p of petals){
    p.ph += .015*dt; p.y += p.vy*dt; p.x += Math.sin(p.ph)*p.sw*dt*devicePixelRatio; p.a += p.va*dt;
    if (p.y > H + p.r*2) Object.assign(p, mkPetal(-p.r*2));
    petal(p);
  }
  for (let i=burst.length-1;i>=0;i--){
    const p = burst[i]; p.vy += .12*dt*devicePixelRatio; p.x += p.vx*dt; p.y += p.vy*dt; p.a += p.va*dt; p.life -= dt;
    p.o = Math.max(0, Math.min(1, p.life/40));
    petal(p); if (p.life<=0 || p.y > H+40) burst.splice(i,1);
  }
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
function doBurst(cx, cy, n){
  if (reduce) n = Math.round(n/3);
  for (let i=0;i<n;i++){
    const ang = rnd(-Math.PI, 0) , sp = rnd(4,14)*devicePixelRatio;
    burst.push({ x: cx, y: cy, r: rnd(6,13)*devicePixelRatio, a: rnd(0,6), va: rnd(-.15,.15),
      vx: Math.cos(ang)*sp*rnd(.6,1.4), vy: Math.sin(ang)*sp, hue: Math.random()<.6?'rose':'gold', o:1, life: rnd(60,120) });
  }
}

/* ---------- music: a small synthesized piano piece (no files needed) ---------- */
const Music = (() => {
  let ac, master, playing = false, timer, nextTime = 0, audioEl = null;
  const BPM = 72, SPB = 60/BPM, LOOP = 32;
  const chords = [[60,64,67],[55,59,62],[57,60,64],[53,57,60]];  // C  G  Am  F
  const bass   = [48,43,45,41];
  const melody = [ // [midi, beats] per bar, 8 bars
    [[76,1],[79,1],[81,.5],[79,.5],[76,1]], [[74,1.5],[71,.5],[74,2]],
    [[72,1],[76,1],[81,1],[79,1]],          [[77,1],[76,.5],[74,.5],[72,2]],
    [[76,1],[79,1],[84,1],[83,1]],          [[79,1.5],[81,.5],[83,2]],
    [[81,1],[79,.5],[76,.5],[74,1],[72,1]], [[74,1],[72,.5],[74,.5],[72,2]]
  ];
  const events = [];
  for (let bar=0; bar<8; bar++){
    const ch = chords[bar%4], b0 = bar*4;
    events.push({ b:b0, n:bass[bar%4], d:1.8, v:.5, k:'bass' });
    events.push({ b:b0+2, n:bass[bar%4]+7, d:1.6, v:.3, k:'bass' });
    const arp = [ch[0],ch[1],ch[2],ch[1]+12,ch[2],ch[1],ch[0]+12,ch[1]];
    arp.forEach((n,i)=>events.push({ b:b0+i*.5, n, d:.9, v:.16, k:'arp' }));
    ch.forEach(n=>events.push({ b:b0, n:n, d:4, v:.045, k:'pad' }));
    let t=0; for (const [n,d] of melody[bar]){ events.push({ b:b0+t, n, d:d*.95, v:.3, k:'lead' }); t+=d; }
  }
  const f = m => 440*Math.pow(2,(m-69)/12);
  function voice(e, t){
    const o = ac.createOscillator(), g = ac.createGain();
    const dur = e.d*SPB;
    o.type = e.k==='lead' ? 'triangle' : e.k==='pad' ? 'sine' : 'sine';
    o.frequency.value = f(e.n);
    let o2;
    if (e.k==='lead' || e.k==='arp'){ o2 = ac.createOscillator(); o2.type='sine'; o2.frequency.value=f(e.n)*2; const g2=ac.createGain(); g2.gain.value=e.k==='lead'?.25:.15; o2.connect(g2).connect(g); o2.start(t); o2.stop(t+dur+.1); }
    const att = e.k==='pad' ? .6 : .012;
    g.gain.setValueAtTime(0,t);
    g.gain.linearRampToValueAtTime(e.v,t+att);
    g.gain.exponentialRampToValueAtTime(e.v*.5, t+att+dur*.35);
    g.gain.exponentialRampToValueAtTime(.0001, t+dur);
    o.connect(g).connect(master);
    o.start(t); o.stop(t+dur+.1);
  }
  function tick(){
    while (nextTime < ac.currentTime + 1.5){
      for (const e of events) voice(e, nextTime + e.b*SPB);
      nextTime += LOOP*SPB;
    }
  }
  function build(){
    ac = new (window.AudioContext||window.webkitAudioContext)();
    master = ac.createGain(); master.gain.value = 0;
    const lp = ac.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=2600;
    const dl = ac.createDelay(1); dl.delayTime.value = SPB*.75;
    const fb = ac.createGain(); fb.gain.value = .32;
    const wet = ac.createGain(); wet.gain.value = .28;
    const comp = ac.createDynamicsCompressor();
    master.connect(lp).connect(comp).connect(ac.destination);
    lp.connect(dl).connect(fb).connect(dl); dl.connect(wet).connect(comp);
  }
  function startSynth(){
    build();
    ac.resume();
    nextTime = ac.currentTime + .05;
    master.gain.cancelScheduledValues(ac.currentTime);
    master.gain.setValueAtTime(0, ac.currentTime);
    master.gain.linearRampToValueAtTime(.9, ac.currentTime + 2);
    tick(); timer = setInterval(tick, 400); playing = true;
  }
  let fileFailed = false; const endedFns = [];
  function start(){
    if (CONFIG.musicFile && !fileFailed){
      if (!audioEl){
        audioEl = new Audio(CONFIG.musicFile); audioEl.loop = false; audioEl.volume = .8; audioEl.preload = 'auto';
        audioEl.addEventListener('ended', ()=>{ playing = false; syncMusic(); endedFns.forEach(f=>f()); });
        audioEl.addEventListener('error', ()=>{ fileFailed = true; audioEl = null; if (playing){ playing = false; startSynth(); syncMusic(); } });
      }
      playing = true;
      audioEl.play().catch(()=>{ if (fileFailed) return; });
      return;
    }
    startSynth();
  }
  function stop(){
    if (audioEl){ audioEl.pause(); playing=false; return; }
    if (!ac) return;
    master.gain.cancelScheduledValues(ac.currentTime);
    master.gain.setValueAtTime(master.gain.value, ac.currentTime);
    master.gain.linearRampToValueAtTime(0, ac.currentTime + .8);
    clearInterval(timer);
    const old = ac; ac = null; setTimeout(()=>{ old.close(); }, 900); playing = false;
  }
  function ready(){  // resolves with the song length in seconds (fallback 150 s for the synth)
    return new Promise(res=>{
      if (!audioEl || fileFailed) return res(150);
      if (isFinite(audioEl.duration) && audioEl.duration>0) return res(audioEl.duration);
      const done = ()=>res(isFinite(audioEl.duration)&&audioEl.duration>0 ? audioEl.duration : 150);
      audioEl.addEventListener('loadedmetadata', done, { once:true });
      audioEl.addEventListener('error', done, { once:true });
      setTimeout(done, 3000);
    });
  }
  return { toggle(){ playing ? stop() : start(); return playing; }, start, ready, onEnded(f){ endedFns.push(f); },
           get playing(){ return playing; }, get usingFile(){ return !!audioEl && !fileFailed; } };
})();
const musicBtn = $('#music');
function syncMusic(){ musicBtn.classList.toggle('playing', Music.playing); musicBtn.setAttribute('aria-pressed', Music.playing);
  $('#musicLabel').textContent = Music.playing ? (Music.usingFile ? CONFIG.musicTitle : 'Nhạc đang phát') : 'Bật nhạc'; }
musicBtn.addEventListener('click', ()=>{ Music.toggle(); syncMusic(); });

/* ---------- director: plays the whole card by itself, timed to the song ---------- */
const Director = (() => {
  let timers = [], active = false, startedAt = 0;
  const api = { autoScroll: true, get active(){ return active; } };
  const at = (ms, fn) => timers.push(setTimeout(fn, Math.max(0, ms - (performance.now() - startedAt))));
  const go = (el, block) => { if (api.autoScroll) el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block }); };
  const toast = msg => { const t = $('#toast'); t.textContent = msg; t.classList.add('on'); setTimeout(()=>t.classList.remove('on'), 2600); };
  function reset(){ wishBox.classList.remove('float'); [...garden.children].forEach(f=>f.classList.remove('active')); }
  function clear(){ timers.forEach(clearTimeout); timers = []; reset(); }
  function run(D){                       // D = song length in seconds, measured from when the cover opened
    active = true; document.body.classList.add('auto');
    const s = 1000, hero = Math.max(3, D*.11), letter = D*.34, gardenT = D*.30, wall = D*.11;
    const T1 = hero*s, T2 = T1 + letter*s, T3 = T2 + gardenT*s, T4 = T3 + wall*s, END = D*s;
    at(T1, ()=>{ go($('.letter'), 'start'); typeLetter(Math.max(8, (letter*s - 2500) / (CONFIG.letter.length*1.9)), true); });
    at(T2, ()=>{ go($('#garden'), 'start'); bloomAll(); wishBox.classList.add('float'); });
    const per = (gardenT*s - 1800) / CONFIG.wishes.length;
    CONFIG.wishes.forEach((w,i)=>at(T2 + 1800 + i*per, ()=>{ showWish(i); go(garden.children[i], 'center'); }));
    at(T3, ()=>{ reset(); go($('#wall'), 'center'); });
    at(T4, ()=>{ go($('.finale'), 'center'); });
    for (let t = T4 + 900; t < END - 400; t += 2400) at(t, ()=>burstAtEl($('#finaleBig'), 70));
    at(END + 400, finish);              // also reached by the song's "ended" event
  }
  function finish(){
    if (!active) return; active = false; clear(); document.body.classList.remove('auto');
    go($('.finale'), 'center'); burstAtEl($('#finaleBig'), 160);
    const rb = $('#replayBtn'); rb.hidden = false; requestAnimationFrame(()=>rb.classList.add('on'));
  }
  function start(){ startedAt = performance.now(); Music.ready().then(run); Music.onEnded(finish); }
  ['wheel','touchmove','keydown'].forEach(ev=>addEventListener(ev, e=>{
    if (!active || !api.autoScroll) return;
    if (ev==='keydown' && !['ArrowDown','ArrowUp','PageDown','PageUp',' ','Home','End'].includes(e.key)) return;
    api.autoScroll = false; toast('Em đang tự cuộn. Giờ em xem theo ý mình nhé.');
  }, { passive:true }));
  return Object.assign(api, { start, finish });
})();
function burstAtEl(el, n){ const r = el.getBoundingClientRect(); doBurst((r.left+r.width/2)*devicePixelRatio, (r.top+r.height/2)*devicePixelRatio, n); }
$('#replayBtn').addEventListener('click', ()=>location.reload());

/* ---------- open the envelope ---------- */
let opened = false;
function open(){
  if (opened) return; opened = true;
  const env = $('#env'); env.classList.add('open');
  try { Music.start(); } catch(e){}
  syncMusic();
  const r = env.getBoundingClientRect();
  setTimeout(()=>doBurst((r.left+r.width/2)*devicePixelRatio, (r.top+r.height*.4)*devicePixelRatio, 90), 650);
  setTimeout(()=>{
    $('#cover').classList.add('gone'); $('#page').classList.add('show'); musicBtn.classList.add('show');
    document.body.classList.remove('locked'); scrollTo(0,0);
    Director.start();
  }, 1500);
}
$('#env').addEventListener('click', open);
$('#env').addEventListener('keydown', e=>{ if (e.key==='Enter'||e.key===' ') { e.preventDefault(); open(); } });
$('#openBtn').addEventListener('click', open);
$('#burstBtn').addEventListener('click', e=>{ const r=e.target.getBoundingClientRect(); doBurst((r.left+r.width/2)*devicePixelRatio,(r.top)*devicePixelRatio,120); });

/* ---------- scroll reveal ---------- */
const ios = document.querySelectorAll('.io');
if ('IntersectionObserver' in window && !reduce){
  ios.forEach(el=>el.classList.add('pre'));
  const obs = new IntersectionObserver(es=>es.forEach(en=>{ if(en.isIntersecting){ en.target.classList.add('in'); en.target.classList.remove('pre'); obs.unobserve(en.target); } }), { threshold:.12 });
  ios.forEach(el=>obs.observe(el));
}

/* ---------- letter typewriter ---------- */
let typed = false;
function typeLetter(ms = 30, follow = false){
  if (typed) return; typed = true;
  const body = $('#letterBody'), cur = body.querySelector('.cursor'), text = CONFIG.letter;
  if (reduce){ body.textContent = text; $('#letterSign').classList.add('on'); return; }
  let i = 0;
  (function step(){
    if (i >= text.length){ cur.remove(); $('#letterSign').classList.add('on'); if (follow && Director.autoScroll) $('#letterSign').scrollIntoView({ behavior:'smooth', block:'nearest' }); return; }
    const c = text[i++]; body.insertBefore(document.createTextNode(c), cur);
    if (follow && Director.autoScroll && c==='\n') cur.scrollIntoView({ behavior:'smooth', block:'center' });
    setTimeout(step, c==='\n' ? ms*8 : /[,.!?]/.test(c) ? ms*5 : ms + Math.random()*ms);
  })();
}
new IntersectionObserver(es=>{ if (es.some(e=>e.isIntersecting)) typeLetter(); }, { threshold:.35 }).observe($('.letter'));

/* ---------- garden: flowers drawn in SVG ---------- */
const PALETTES = [
  ['#ff8fb1','#ffd0de','#f4cd7a'], ['#f4cd7a','#fff0c2','#d9426f'], ['#ffb3c7','#ffe3ea','#f4cd7a'],
  ['#e07aa0','#ffc3d4','#fff2b5'], ['#ffa8a8','#ffe0d6','#f4cd7a']
];
function flowerSVG(i){
  const [c1,c2,c3] = PALETTES[i%PALETTES.length];
  const n = 5 + (i%3); let petals = '';
  for (let k=0;k<n;k++){
    const a = 360/n*k;
    petals += `<g style="transform:rotate(${a}deg)"><path d="M50 50 C 38 36, 36 14, 50 6 C 64 14, 62 36, 50 50 Z" fill="url(#pg${i})" stroke="${c2}" stroke-width=".6" opacity=".95"/></g>`;
  }
  return `<svg viewBox="0 0 100 130" aria-hidden="true">
    <defs><radialGradient id="pg${i}" cx="50%" cy="80%" r="70%"><stop offset="0" stop-color="${c1}"/><stop offset="1" stop-color="${c2}"/></radialGradient></defs>
    <path class="stem" d="M50 58 C 52 80, 46 100, 50 128" fill="none" stroke="#7fbf8a" stroke-width="2.2" stroke-linecap="round"/>
    <path class="stem" d="M50 95 C 38 92, 32 84, 34 78 C 44 78, 50 86, 50 95 Z" fill="#8ccf97" stroke="#8ccf97"/>
    <g class="petals">${petals}<circle cx="50" cy="50" r="8" fill="${c3}"/><circle cx="48" cy="48" r="3" fill="#fff6d6" opacity=".8"/></g>
  </svg>`;
}
const garden = $('#garden'), wishBox = $('#wish');
CONFIG.wishes.forEach((w,i)=>{
  const b = document.createElement('button'); b.className='flower'; b.type='button';
  b.setAttribute('aria-label','Lời chúc ' + (i+1) + ': ' + w.k);
  b.innerHTML = flowerSVG(i) + `<span class="cap">${w.k}</span>`;
  b.addEventListener('click', ()=>showWish(i));
  garden.appendChild(b);
});
function showWish(i){
  const w = CONFIG.wishes[i], b = garden.children[i];
  [...garden.children].forEach(f=>f.classList.toggle('active', f===b));
  wishBox.classList.add('swap');
  const r = b.getBoundingClientRect(); doBurst((r.left+r.width/2)*devicePixelRatio,(r.top+r.height*.3)*devicePixelRatio,28);
  setTimeout(()=>{ wishBox.innerHTML = `${w.t}<small>${w.k}</small>`; wishBox.classList.remove('swap'); }, 320);
}
function bloomAll(){ [...garden.children].forEach((f,i)=>setTimeout(()=>{ f.classList.add('bloom'); setTimeout(()=>f.classList.add('sway'),1500); }, i*180)); }
new IntersectionObserver(es=>{ if (es.some(e=>e.isIntersecting)) bloomAll(); }, { threshold:.3 }).observe(garden);
if (reduce) [...garden.children].forEach(f=>f.classList.add('bloom'));

/* ---------- photo wall ---------- */
const wall = $('#wall'), tilts = [-4, 3, -2, 5, -3, 2];
const defaults = [
  { cap:'Nắng sớm', seed:1 }, { cap:'Hoa cho em', seed:2 }, { cap:'Một chiều thu', seed:3 }, { cap:'Ánh đèn thành phố', seed:4 }
];
function illustrate(cv, seed){
  const s = 480; cv.width = s; cv.height = s; const c = cv.getContext('2d');
  const R = (() => { let x = seed*9301+49297; return ()=>{ x = (x*9301+49297)%233280; return x/233280; }; })();
  const g = c.createLinearGradient(0,0,s,s);
  const hues = [['#3b1a45','#d9426f'],['#2a1134','#f4cd7a'],['#5a2a63','#ff8fb1'],['#1f1a3a','#ffb28a']][seed%4];
  g.addColorStop(0,hues[0]); g.addColorStop(1,hues[1]); c.fillStyle=g; c.fillRect(0,0,s,s);
  for (let i=0;i<40;i++){ const x=R()*s,y=R()*s,r=20+R()*90; const rg=c.createRadialGradient(x,y,0,x,y,r); rg.addColorStop(0,'rgba(255,230,240,.35)'); rg.addColorStop(1,'rgba(255,230,240,0)'); c.fillStyle=rg; c.beginPath(); c.arc(x,y,r,0,7); c.fill(); }
  const cx = s*.5, cy = s*.58, n = 6 + (seed%3);
  for (let k=0;k<n;k++){ c.save(); c.translate(cx,cy); c.rotate(k*Math.PI*2/n); const pg=c.createLinearGradient(0,0,0,-150); pg.addColorStop(0,'#ffd0de'); pg.addColorStop(1,'#ff7fa6'); c.fillStyle=pg; c.beginPath(); c.moveTo(0,0); c.bezierCurveTo(60,-50,60,-130,0,-160); c.bezierCurveTo(-60,-130,-60,-50,0,0); c.fill(); c.restore(); }
  c.fillStyle='#f4cd7a'; c.beginPath(); c.arc(cx,cy,34,0,7); c.fill();
  c.fillStyle='rgba(255,246,214,.9)'; c.beginPath(); c.arc(cx-10,cy-10,10,0,7); c.fill();
}
const photos = CONFIG.photos.length ? CONFIG.photos : defaults;
photos.forEach((p,i)=>{
  const d = document.createElement('figure'); d.className='pola'; d.style.setProperty('--tilt', tilts[i%tilts.length]+'deg'); d.style.margin=0;
  const ph = document.createElement('div'); ph.className='ph';
  if (p.src){ const im = new Image(); im.src = p.src; im.alt = p.cap||''; im.loading='lazy'; ph.appendChild(im); }
  else { const cv = document.createElement('canvas'); illustrate(cv, p.seed||i+1); ph.appendChild(cv); }
  d.innerHTML = '<span class="tape"></span>'; d.appendChild(ph);
  const cap = document.createElement('figcaption'); cap.className='cap'; cap.textContent = p.cap||''; d.appendChild(cap);
  wall.appendChild(d);
});
$('#wallNote').textContent = CONFIG.photos.length ? '' : 'Bốn bức tranh nhỏ vẽ bằng ánh sáng, mỗi bức là một khoảnh khắc có em ở trong đó.';
</script>
